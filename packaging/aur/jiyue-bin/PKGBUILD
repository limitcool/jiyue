# Maintainer: limitcool <initcoool@gmail.com>

pkgname=jiyue-bin
pkgver=0.4.0
pkgrel=1
pkgdesc='Local-first Markdown note-taking app with wikilinks, graph view, and S3/WebDAV sync'
arch=('x86_64' 'aarch64')
url='https://github.com/limitcool/jiyue'
license=('MIT OR Apache-2.0')
depends=(
    'glibc'
    'gcc-libs'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'fontconfig'
    'wayland'
    'vulkan-icd-loader'
    'hicolor-icon-theme'
)
optdepends=(
    'vulkan-driver: GPU-accelerated rendering'
    'alsa-lib: audio support'
)
provides=('jiyue')
conflicts=('jiyue')
options=('!strip')

source=("LICENSE-MIT-${pkgver}::https://raw.githubusercontent.com/limitcool/jiyue/v${pkgver}/LICENSE-MIT")
source_x86_64=("${pkgname}-${pkgver}-x86_64.deb::https://github.com/limitcool/jiyue/releases/download/v${pkgver}/jiyue_${pkgver}_amd64.deb")
source_aarch64=("${pkgname}-${pkgver}-aarch64.deb::https://github.com/limitcool/jiyue/releases/download/v${pkgver}/jiyue_${pkgver}_arm64.deb")

sha256sums=('eb33876e90f87972376c05d8dcea328f3721b724948b380d1d8386577f09d034')
sha256sums_x86_64=('6e864770c527654a8e850c0b581d2145cedb1945cb3ea82ab30cc9284ebccff1')
sha256sums_aarch64=('ba86c85a9fdfde0e2213372ce9f3b8bba84cb6ab5b16b5497b58258bdb59690d')

package() {
    bsdtar -xf "${srcdir}/data.tar."* -C "${pkgdir}"
    install -Dm644 "${srcdir}/LICENSE-MIT-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
}
